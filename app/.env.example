# Neon pooled Postgres connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public deployment URL, without a trailing slash
HOOKIN_APP_URL=http://localhost:3200

# Long random bearer token for /api/cron/retry-failed
CRON_SECRET=replace-with-a-long-random-secret

# Optional: required only for email alert rules
RESEND_API_KEY=
HOOKIN_ALERT_FROM=HookIn Alerts <alerts@your-domain.com>