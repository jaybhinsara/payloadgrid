# Neon pooled PostgreSQL connection string
DATABASE_URL=

# Canonical public URL, without a trailing slash.
# Production uses https://payloadgrid.com
NEXT_PUBLIC_SITE_URL=http://localhost:3200
PAYLOADGRID_APP_URL=http://localhost:3200
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com
# Required before paid checkout: registered individual or business name shown in legal notices.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
# Optional Google Search Console HTML-tag verification value.
GOOGLE_SITE_VERIFICATION=

# Public blog cover image uploads (created by a Vercel Blob store)
BLOB_READ_WRITE_TOKEN=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYLOADGRID_ENCRYPTION_KEY=
PAYLOADGRID_EMBED_SECRET=
CRON_SECRET=

# Durable delivery queue (Upstash QStash)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Optional failure email delivery
RESEND_API_KEY=
PAYLOADGRID_ALERT_FROM=
PAYLOADGRID_AUTH_FROM=
# Platform monitoring operators and optional incident notifications
PAYLOADGRID_OPERATOR_EMAILS=
PAYLOADGRID_INCIDENT_ALERT_TO=
PAYLOADGRID_INCIDENT_ALERT_WEBHOOK=

# Optional OAuth sign-in providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Razorpay Standard Checkout (secret remains server-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Existing public prices use USD. Change only when plan prices are also changed.
RAZORPAY_CHECKOUT_CURRENCY=USD
