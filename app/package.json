{
  "name": "payloadgrid-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "npm run build && node ops/http-smoke.mjs",
    "test:integration": "node ops/integration-test.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:smoke",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "config:check": "node ops/validate-production-env.mjs",
    "db:bootstrap": "node ops/migrate.mjs bootstrap",
    "db:baseline": "node ops/migrate.mjs baseline",
    "db:migrate": "node ops/migrate.mjs migrate",
    "db:status": "node ops/migrate.mjs status",
    "recovery:capture": "node ops/recovery-evidence.mjs capture",
    "recovery:verify": "node ops/recovery-evidence.mjs verify"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@upstash/qstash": "2.11.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.8.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "jose": "6.2.8",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "razorpay": "2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2"
  }
}
